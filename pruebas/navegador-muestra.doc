sition:absolute;margin-left:72.00pt;margin-top:105.33pt;width:456.58pt;height:13.75pt;z-index:100002;mso-position-horizontal-relative:page;mso-position-vertical-relative:page;mso-wrap-style:none" filled="f" stroked="f"><v:textbox inset="0,0,0,0"><w:txbxContent><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="275" w:line-rule="exact"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:fareast="Times New Roman" w:h-ansi="Times New Roman" w:cs="Times New Roman"/><w:sz w:val="22"/><w:sz-cs w:val="22"/></w:rPr><w:t>prueba contiene acentos (canción, árbol, pingüino, ñandú) y signos de puntuación para verificar que el</w:t></w:r></w:p></w:txbxContent></v:textbox><w10:wrap type="none"/><w10:anchorlock/></v:shape></w:pict></w:r><w:r><w:pict><v:shape id="txt215" type="#_x0000_t202" style="position:absolute;margin-left:72.00pt;margin-top:119.63pt;width:458.43pt;height:13.75pt;z-index:100003;mso-position-horizontal-relative:page;mso-position-vertical-relative:page;mso-wrap-style:none" filled="f" stroked="f"><v:textbox inset="0,0,0,0"><w:txbxContent><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="275" w:line-rule="exact"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:fareast="Times New Roman" w:h-ansi="Times New Roman" w:cs="Times New Roman"/><w:sz w:val="22"/><w:sz-cs w:val="22"/></w:rPr><w:t>texto se extrae como texto real y no como imagen. Cada línea debe quedar en el mismo lugar que en el</w:t></w:r></w:p></w:txbxContent></v:textbox><w10:wrap type="none"/><w10:anchorlock/></v:shape></w:pict></w:r><w:r><w:pict><v:shape id="txt216" type="#_x0000_t202" style="position:absolute;margin-left:72.00pt;margin-top:133.93pt;width:456.30pt;height:13.75pt;z-index:100004;mso-position-horizontal-relative:page;mso-position-vertical-relative:page;mso-wrap-style:none" filled="f" stroked="f"><v:textbox inset="0,0,0,0"><w:txbxContent><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="275" w:line-rule="exact"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times Ne