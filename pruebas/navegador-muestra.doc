ap type="none"/><w10:anchorlock/></v:shape></w:pict></w:r><w:r><w:pict><v:shape id="txt51" type="#_x0000_t202" style="position:absolute;margin-left:72.00pt;margin-top:257.33pt;width:449.51pt;height:13.75pt;z-index:100039;mso-position-horizontal-relative:page;mso-position-vertical-relative:page;mso-wrap-style:none" filled="f" stroked="f"><v:textbox inset="0,0,0,0"><w:txbxContent><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="275" w:line-rule="exact"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:fareast="Times New Roman" w:h-ansi="Times New Roman" w:cs="Times New Roman"/><w:sz w:val="22"/><w:sz-cs w:val="22"/></w:rPr><w:t>documentos requiere conservar la posición exacta de cada elemento. Este párrafo de prueba contiene</w:t></w:r></w:p></w:txbxContent></v:textbox><w10:wrap type="none"/><w10:anchorlock/></v:shape></w:pict></w:r><w:r><w:pict><v:shape id="txt52" type="#_x0000_t202" style="position:absolute;margin-left:72.00pt;margin-top:271.63pt;width:450.16pt;height:13.75pt;z-index:100040;mso-position-horizontal-relative:page;mso-position-vertical-relative:page;mso-wrap-style:none" filled="f" stroked="f"><v:textbox inset="0,0,0,0"><w:txbxContent><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="275" w:line-rule="exact"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:fareast="Times New Roman" w:h-ansi="Times New Roman" w:cs="Times New Roman"/><w:sz w:val="22"/><w:sz-cs w:val="22"/></w:rPr><w:t>acentos (canción, árbol, pingüino, ñandú) y signos de puntuación para verificar que el texto se extrae</w:t></w:r></w:p></w:txbxContent></v:textbox><w10:wrap type="none"/><w10:anchorlock/></v:shape></w:pict></w:r><w:r><w:pict><v:shape id="txt53" type="#_x0000_t202" style="position:absolute;margin-left:72.00pt;margin-top:285.93pt;width:470.37pt;height:13.75pt;z-index:100041;mso-position-horizontal-relative:page;mso-position-vertical-relative:page;mso-wrap-style:none" filled="f" stroked="f"><v:textbox inset="0,0,0,0"><w:txbxContent><w:p><w:pPr><